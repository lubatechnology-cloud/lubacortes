# ============================================================================
# LUBACORTES — Variáveis de ambiente para a VERCEL
# Copiar cada valor no painel: Vercel > Project > Settings > Environment Variables
# NUNCA colocar estes valores em ficheiros versionados nem no frontend.
# ============================================================================

# ----------------------------------------------------------------------------
# OBRIGATÓRIO — aplicação
# ----------------------------------------------------------------------------
APP_URL=https://O_SEU_PROJECTO.vercel.app
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ----------------------------------------------------------------------------
# OBRIGATÓRIO — base de dados e armazenamento (fora do filesystem efémero)
# A Vercel NÃO permite gravar SQLite nem ficheiros locais persistentes.
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@host:5432/lubacortes
DIRECT_URL=postgresql://usuario:senha@host:5432/lubacortes

# Supabase Storage (bucket PRIVADO) ou S3 compatível
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lubacortes-private
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# OBRIGATÓRIO — worker externo (Railway / Render / Fly.io)
# O processamento de vídeo NÃO corre em funções serverless da Vercel.
# ----------------------------------------------------------------------------
WORKER_URL=https://o-seu-worker.exemplo.com
WORKER_API_TOKEN=
MAX_UPLOAD_MB=2048
RENDER_TIMEOUT_MS=900000
WATERMARK_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
ALLOWED_VIDEO_HOSTS=

# ----------------------------------------------------------------------------
# IA — Groq (gratuito) RECOMENDADO. Uma única chave GROQ_API_KEY serve para
# transcrição Whisper e tradução com LLM. Alternativa paga: OpenAI.
# ----------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=groq
TRANSLATION_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_UPLOAD_MB=24
TRANSCRIBE_CHUNK_SECONDS=600
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ----------------------------------------------------------------------------
# Autofoco (opcional) — none | manual | model
# ----------------------------------------------------------------------------
AUTOFOCUS_PROVIDER=none
AUTOFOCUS_MODEL=AdamCodd/YOLOv11n-face-detection

# ----------------------------------------------------------------------------
# Pagamentos — MODO DE TESTE FIXO. Nunca activar cobranças reais.
# ----------------------------------------------------------------------------
PAYMENT_MODE=test
PAYMENT_REFERENCE_ENABLED=true
PAYMENT_EXPRESS_ENABLED=true
PAYMENT_TRANSFER_IBAN=0040 0000 4040 6279 1012 5
PAYMENT_TRANSFER_BANK=BAI
PAYMENT_TRANSFER_ACCOUNT_NAME=Fausto Silva
PAYMENT_TEST_CONFIRM_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Correio (produção)
# ----------------------------------------------------------------------------
SMTP_URL=
MAIL_FROM=noreply@lubacortes.ao
