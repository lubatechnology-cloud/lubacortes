{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/projects/route.ts": { "maxDuration": 60 },
    "src/app/api/projects/[id]/analyze/route.ts": { "maxDuration": 60 },
    "src/app/api/clips/[id]/download/route.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
