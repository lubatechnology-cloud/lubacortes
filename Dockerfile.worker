# LUBACORTES — worker de processamento de vídeo (Railway / Render / Fly.io)
# A Vercel executa apenas o Next.js; o worker deve correr num serviço com
# sistema de ficheiros persistente e tempo de execução longo.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-dejavu-core \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev && npm cache clean --force
COPY . .

ENV NODE_ENV=production \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    FFPROBE_PATH=/usr/bin/ffprobe \
    WATERMARK_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    TRANSCRIPTION_PROVIDER=openai \
    TRANSLATION_PROVIDER=openai

CMD ["npm", "run", "worker"]
