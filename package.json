{
  "name": "lubacortes",
  "version": "1.0.0",
  "private": true,
  "description": "Lubacortes - Plataforma SaaS de cortes inteligentes de vídeo com IA",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:once": "tsx worker/once.ts",
    "dev:all": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx watch worker/index.ts\"",
    "db:init": "tsx scripts/db-init.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "schema:postgres": "tsx scripts/gen-postgres-schema.ts",
    "check:deploy": "tsx scripts/check-deploy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "better-sqlite3": "^12.4.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.4",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true
  }
}
