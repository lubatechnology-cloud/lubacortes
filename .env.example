# ============================================================================
# LUBACORTES — Configuração de ambiente (copiar para .env.local)
# NUNCA colocar chaves secretas no frontend. Todas as variáveis abaixo são
# lidas apenas no servidor (Route Handlers / worker).
# ============================================================================

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Segredo para assinar tokens de download de curta duração e tokens de API.
# GERAR COM: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=substituir_por_um_segredo_aleatorio_de_32_bytes

# ---------------------------------------------------------------------------
# Entrar com Google (identidade / login — NÃO é usado para descarregar vídeos)
# Criar as credenciais em https://console.cloud.google.com/apis/credentials
# Tipo: "ID de cliente OAuth" -> Aplicação Web
# URI de redirecionamento autorizada: http://localhost:3000/api/auth/google/callback
# Em produção: https://lubacortes.vercel.app/api/auth/google/callback
# Deixe vazio para desactivar o botão (a plataforma continua a funcionar com e-mail).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Base de dados (modo local por omissão — SQLite real e persistente)
# Para produção: substituir o repositório por Supabase/Postgres (ver docs).
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/lubacortes.db

# ---------------------------------------------------------------------------
# Armazenamento privado de vídeos (fora de /public)
# Em produção: Supabase Storage / S3 (ver docs/ARQUITECTURA.md).
# ---------------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=2048

# ---------------------------------------------------------------------------
# Supabase (opcional — activar apenas quando as credenciais existirem)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Processamento de vídeo
# ---------------------------------------------------------------------------
FFMPEG_PATH=
FFPROBE_PATH=
WORKER_CONCURRENCY=1
RENDER_TIMEOUT_MS=900000
# Fonte usada na marca de água do plano GRATUITO (deixe vazio para desactivar se não existir)
WATERMARK_FONT_PATH=C:/Windows/Fonts/arial.ttf
# Directórios permitidos para URLs de origem (direct media). Nunca contornar
# protecções de plataformas externas — apenas fonts autorizadas/directas.
# Deixe vazio para aceitar URLs directas de vídeo de qualquer host público.
# Use uma lista separada por vírgulas apenas se quiser restringir hosts.
ALLOWED_VIDEO_HOSTS=

# ---------------------------------------------------------------------------
# Transcrição — provedores: none | groq | local | openai
# groq    -> CAMADA GRATUITA: whisper-large-v3-turbo, API compatível com OpenAI
#            20 req/min, 2.000 req/dia, 7.200 s de áudio/hora, upload até 25 MB.
#            O Lubacortes divide áudios longos em pedaços automaticamente.
# local   -> 100% gratuito e sem chave (Whisper tiny via Transformers.js, mais lento)
# openai  -> pago (whisper-1)
# ---------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=none
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_UPLOAD_MB=24
TRANSCRIBE_CHUNK_SECONDS=600
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
LOCAL_WHISPER_MODEL=Xenova/whisper-tiny
HF_HOME=./data/hf-cache

# ---------------------------------------------------------------------------
# Tradução — provedores: none | groq | openai | libretranslate
# groq           -> LLM gratuito (llama-3.3-70b-versatile) numa única chave GROQ_API_KEY
# libretranslate -> servidor próprio open-source, sem custo de API
# none           -> mantém o texto original e MARCA a legenda como NÃO TRADUZIDA
# ---------------------------------------------------------------------------
TRANSLATION_PROVIDER=none
GROQ_CHAT_MODEL=openai/gpt-oss-20b
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ---------------------------------------------------------------------------
# Motor de IA / pontuação (configurável pelo administrador na BD)
# ---------------------------------------------------------------------------
AI_MIN_CLIP_SECONDS=8
AI_MAX_CLIP_SECONDS=60
AI_MAX_CLIPS=12

# Autofoco — none | manual | model (detecção de rostos com modelo ONNX)
AUTOFOCUS_PROVIDER=none
AUTOFOCUS_MODEL=AdamCodd/YOLOv11n-face-detection
# Self-hosted (open-source): use selfhost nos provedores acima e configure:
WHISPERX_URL=
VLLM_BASE_URL=
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
VLLM_API_KEY=
DEEPFACE_URL=
METRICS_TOKEN=
SENTRY_DSN=
AUTOFOCUS_INTERVAL_SECONDS=2

# ---------------------------------------------------------------------------
# Pagamentos — MODO DE TESTE OBRIGATÓRIO
# NUNCA activar cobranças reais sem integração oficial e credenciais.
# ---------------------------------------------------------------------------
PAYMENT_MODE=test
PAYMENT_REFERENCE_ENABLED=true
PAYMENT_EXPRESS_ENABLED=true
# Transferência IBAN — dados de TESTE, configuráveis também no painel administrativo.
PAYMENT_TRANSFER_IBAN=0040 0000 4040 6279 1012 5
PAYMENT_TRANSFER_BANK=BAI
PAYMENT_TRANSFER_ACCOUNT_NAME=Fausto Silva
# Token exigido para confirmar um pagamento de teste no backend.
# Sem este token NENHUM pagamento pode ser confirmado (nem por admin via UI).
PAYMENT_TEST_CONFIRM_TOKEN=substituir_por_token_de_confirmacao_de_teste
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Correio (verificação / recuperação). Em desenvolvimento os tokens são
# impressos no terminal e guardados em data/mail-outbox.log.
# ---------------------------------------------------------------------------
SMTP_URL=
MAIL_FROM=noreply@lubacortes.local
# WhatsApp via API oficial Meta (credenciais próprias)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
